<launch>
  <env name="GAZEBO_RESOURCE_PATH" value="$(find robot)/meshes"/>

  <!-- Arguments -->
  <arg name="robot_name" value="robot"/>
  <arg name="model" default="$(find robot)/urdf/robot/robot.urdf.xacro"/>
  <arg name="cmd_vel" default="/robot/mobile_base_controller/cmd_vel"/>
  <arg name="world" default="large_house"/>

  <!-- start Gazebo with an empty world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="use_sim_time" value="true"/>
    <arg name="debug" value="false"/>
    <arg name="verbose" value="false"/>
    <arg name="world_name" value="$(find robot)/worlds/$(arg world).world"/>
  </include>
  
  <!--Spawns Robot inside a Gazebo simulation -->
  <param name="/robot/robot_description"
        command="xacro $(arg model)"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_$(arg robot_name)" 
        args="-x 0.0 -y 0.5 -z 0.1 -unpause -urdf -param /robot/robot_description -model $(arg robot_name)"    	     respawn="false">
  </node>

  <!--Spawns Controller inside a Gazebo simulation -->
  <rosparam command="load"
            file="$(find robot)/config/manual_drive.yaml"/>
  <!--node name="robot_controller_spawner" pkg="controller_manager" type="spawner"
    ns="/robot" args="joint_state_controller"/ -->
  <node name="robot_controller_spawner" pkg="controller_manager" type="spawner"
    ns="/robot" args="joint_state_controller mobile_base_controller"/> 

  <!--Setup TF -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" ns="/robot">
    <param name="publish_frequency" type="double" value="30.0" />
    <remap from="/joint_states" to="/robot/joint_states"/>
    <remap from="/robot_description" to="/robot/robot_description" />
  </node>

  <!-- RViz -->
  <node type="rviz" name="rviz" pkg="rviz" args="-d $(find robot)/rviz/robot.rviz" />

  <!--Setup manual control through GUI -->
  <param name="/cmd_vel"
        value="$(arg cmd_vel)"/>
  <!-- <node name="rqt_robot_steering" pkg="rqt_robot_steering" type="rqt_robot_steering">
    <param name="default_topic" value="$(arg cmd_vel)"/>
  </node> -->

</launch>
