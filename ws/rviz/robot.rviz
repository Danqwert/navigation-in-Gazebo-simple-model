Panels:
  - Class: rviz/Displays
    Help Height: 104
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 655
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
